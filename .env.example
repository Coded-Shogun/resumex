# Copy to .env.local for `pnpm dev`. Leave the Supabase values empty to run
# against the bundled seed résumé (lib/seed.json) with no database.
SUPABASE_URL=https://supabase.nativesilicon.co.za
SUPABASE_ANON_KEY=
# Comma-separated. Must also be present in the resume_admins table.
ADMIN_EMAILS=thendo@nativesi.co.za
SITE_URL=http://localhost:3000
